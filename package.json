{
  "name": "fluravest",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @fluravest/core migrate",
    "db:seed": "pnpm --filter @fluravest/core seed",
    "db:reset": "pnpm --filter @fluravest/core reset"
  },
  "devDependencies": {
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  }
}
