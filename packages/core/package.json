{
  "name": "@fluravest/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/db/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "reset": "tsx src/scripts/reset.ts && tsx src/scripts/migrate.ts && tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fluravest/domain": "workspace:*",
    "drizzle-orm": "0.44.7",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "@types/node": "22.18.12"
  }
}
